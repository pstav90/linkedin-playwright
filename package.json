{
  "name": "career-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI-assisted job-search sourcing and scoring pipeline backed by Google Sheets.",
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "start": "tsx src/run.ts",
    "dry-run": "DRY_RUN=true tsx src/run.ts",
    "write": "DRY_RUN=false tsx src/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "linkedin:login": "tsx src/linkedinLogin.ts",
    "reprocess": "tsx src/reprocess.ts",
    "write:existing": "tsx src/writeExisting.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^173.0.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
